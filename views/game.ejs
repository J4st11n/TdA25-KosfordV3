<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game</title>
    <link rel="stylesheet" href="/game.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <h1 id="title"></h1>
    <div id="game"></div>
    <div id="status">Player X's turn</div>

    <script>
        window.onload = async () => {
            let game = await fetch(`/api/v1/games/${location.href.match(/\/game\/([a-f0-9\-]+)/)[1]}`, {
                method: "GET"
            });

            let res = await game.json();

            document.getElementById("title").innerText = res.name;
        };
    </script>
</body>
</html>