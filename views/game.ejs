<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game</title>
    <link rel="stylesheet" href="/css/game.css">
    <link rel="icon" href="/img/Think-different-Academy_LOGO_cerny.ico" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/img/Think-different-Academy_LOGO_bily.ico" media="(prefers-color-scheme: dark)">
</head>
<body>
    <div style="align-self: normal; justify-self: normal; left: 0; position: absolute; padding: 3vh;">
        <a style="font-size: large; font-weight: bold; cursor: pointer; border: 3px solid white; padding: 3px;" onclick="location.href = '/'">Go Back</a>
    </div>

    <h1 id="title"></h1>

    <script>
        window.onload = async () => {
            let game = await fetch(`/api/v1/games/${location.href.match(/\/game\/([a-f0-9\-]+)/)[1]}`, {
                method: "GET"
            });

            let res = await game.json();

            document.getElementById("title").innerText = res.name;
        };
    </script>
</body>
</html>