<!DOCTYPE html>
<html>
    <head>
        <title>Kosford Piškvorky</title>
        <link rel="stylesheet" href="/create_game.css">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Create Game</title>
        <link rel="icon" type="image/x-icon" href="/mini.ico">
    </head>
    <body>
        <div style="align-self: normal; justify-self: normal; left: 0; position: absolute; padding: 3vh;">
            <a style="font-size: large; font-weight: bold; cursor: pointer; border: 3px solid white; padding: 3px;" onclick="location.href = '/'">Go Back</a>
        </div>

        <div>
            <div class="name-field">
                <a class="name-title">Název hry:</a>
                <input id="name" type="text" class="game-name" maxlength="40">
            </div>

            <div style="display: grid;">
                <a class="name-title" style="position: relative;left: 5vh;">Obtížnost:</a>
                <div class="button-group">
                    <input type="radio" id="beginner" name="difficulty" value="beginner">
                    <label for="beginner" style="color: white; font-family: sans-serif;" class="beginner">Beginner</label>
                
                    <input type="radio" id="easy" name="difficulty" value="easy">
                    <label for="easy" style="color: white; font-family: sans-serif;" class="easy">Easy</label>
                
                    <input type="radio" id="medium" name="difficulty" value="medium">
                    <label for="medium" style="color: white; font-family: sans-serif;" class="medium">Medium</label>
                
                    <input type="radio" id="hard" name="difficulty" value="hard">
                    <label for="hard" style="color: white; font-family: sans-serif;" class="hard">Hard</label>
                
                    <input type="radio" id="extreme" name="difficulty" value="extreme">
                    <label for="extreme" style="color: white; font-family: sans-serif;" class="extreme">Extreme</label>
                </div>
            </div>

            <div style="padding: 5vh;">
                <button onclick="createGame()" type="button" class="start-button">START</button>
            </div>
        </div>

        <script>
            async function createGame(){
                let name = document.getElementById("name")
                let difficulty = document.querySelector('input[name="difficulty"]:checked');

                let game = await fetch("/api/v1/games", {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        name: name.value,
                        difficulty: difficulty.value,
                        board: Array(15).fill(Array(15).fill(""))
                    })
                });

                let output = document.getElementById("output");

                let res = await game.json()

                console.log(game.status, res.uuid)

                if(game.status === 201){
                    location.href = `/game/${res.uuid}`
                };
            };
        </script>
    </body>
</html>